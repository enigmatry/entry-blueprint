{
  "name": "enigmatry-entry-blueprint-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:aspire": "run-script-os",
    "start:aspire:win32": "ng serve --port %PORT%",
    "start:aspire:default": "ng serve --port $PORT",
    "build": "ng build",
    "build-and-lint": "concurrently -P \"npm run lint:ts:ci\" \"npm run lint:styles:ci\" \"npm run build -- {@}\" --",
    "test": "ng test",
    "test:ci": "ng test --configuration ci",
    "lint": "concurrently \"npm run lint:ts\" \"npm run lint:styles\"",
    "lint:ts": "eslint --fix",
    "lint:ts:ci": "eslint",
    "lint:styles": "stylelint --fix src/**/*.scss",
    "lint:styles:ci": "stylelint src/**/*.scss",
    "nswag": "node_modules\\.bin\\nswag run nswag.json",
    "codegen:run": "entry-codegen --source-assembly ../Enigmatry.Entry.Blueprint.CodeGeneration.Setup/bin/Debug/net10.0/Enigmatry.Entry.Blueprint.CodeGeneration.Setup.dll --destination-directory ./src/app/features --standalone-components true",
    "codegen:run-i18n": "entry-codegen --source-assembly ../Enigmatry.Entry.Blueprint.CodeGeneration.Setup/bin/Debug/net10.0/Enigmatry.Entry.Blueprint.CodeGeneration.Setup.dll --destination-directory ./src/app/features --enable-i18n true --standalone-components true",
    "codegen:install": "dotnet tool install enigmatry.entry.codegeneration.tools -g",
    "codegen:update": "dotnet tool update enigmatry.entry.codegeneration.tools -g",
    "i18n": "ng extract-i18n --format json --output-path src/i18n --out-file messages.en.json & sortjson src/i18n"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/material-date-fns-adapter": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@azure/msal-browser": "4.21.0",
    "@enigmatry/entry-components": "21.2.1",
    "@enigmatry/entry-form": "21.2.1",
    "@microsoft/applicationinsights-web": "3.3.10",
    "@ngx-formly/core": "7.1.0",
    "@ngx-formly/material": "7.1.0",
    "date-fns": "^4.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/localize": "^21.2.25",
    "@enigmatry/eslint-config": "21.1.1",
    "@enigmatry/scss-foundation": "21.1.1",
    "@enigmatry/stylelint-config": "21.1.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "10.0.4",
    "jsdom": "29.1.1",
    "json-sort-cli": "^4.1.0",
    "nswag": "^14.6.2",
    "run-script-os": "^1.1.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
