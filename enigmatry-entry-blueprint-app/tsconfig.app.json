    "outDir": "./out-tsc/app",
    "noImplicitOverride": false,
    "types": [
      "@angular/localize"
    ]
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/app/api/**/*"
  ]
